# OpenAI API 키는 VITE_ 접두사를 붙이지 마세요. 브라우저에 노출됩니다.
OPENAI_API_KEY=

# 교사용 4자리 비밀번호. 지정하지 않으면 기본값이 사용됩니다.
# 이 값은 화면 어디에도 노출되지 않습니다.
SETTINGS_PIN=

# 24자 이상의 임의 문자열. /settings 화면에서 API 키를 저장하려면 필요합니다.
SETTINGS_ENCRYPTION_KEY=

# 비용 기본값: 학생 1명당 이미지 생성 1회
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536
